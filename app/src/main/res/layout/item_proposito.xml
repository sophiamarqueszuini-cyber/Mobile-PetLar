<?xml version="1.0" encoding="utf-8"?>
<!-- .stat-item -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PetLar.Card.Arredondado"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFDFDFD"
    app:contentPadding="18dp"
    app:strokeColor="#FFEAEAEA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PetLar.CartaoTitulo"
            android:textSize="16sp"
            tools:text="Atendimento exclusivo" />

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.PetLar.Corpo"
            android:textSize="14sp"
            tools:text="Ambientes planejados com hora marcada para o bem-estar absoluto." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

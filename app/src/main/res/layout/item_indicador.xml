<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador do painel (mesmo cartão do .stat-item) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PetLar.Card.Arredondado"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:contentPadding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/zilla_slab_semibold"
            android:textColor="@color/petlar_marrom"
            android:textSize="24sp"
            tools:text="R$ 1.250,00" />

        <TextView
            android:id="@+id/txtRotulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.PetLar.Tag"
            android:textSize="11sp"
            tools:text="Faturamento" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- .cartao.pedido do painel administrativo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PetLar.Card.Painel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:contentPaddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- .pedido-topo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/zilla_slab_medium"
                android:textColor="@color/petlar_texto"
                android:textSize="19sp"
                tools:text="Pedido #882421" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_status"
                android:fontFamily="@font/zilla_slab_semibold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="3dp"
                android:textColor="@color/status_texto"
                android:textSize="13sp"
                tools:text="Pagamento confirmado" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/petlar_texto_secundario"
            android:textSize="14sp"
            tools:text="Maria Silva · maria@petlar.com" />

        <TextView
            android:id="@+id/txtDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/petlar_texto_secundario"
            android:textSize="14sp"
            tools:text="28/09/2026 12:05 · 3 itens · ⚡ PIX" />

        <!-- .itens: uma linha item_produto_pedido por produto, entre duas linhas -->
        <LinearLayout
            android:id="@+id/listaItens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fundo_itens_pedido"
            android:orientation="vertical"
            android:paddingVertical="12dp" />

        <!-- .pedido-rodape -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/zilla_slab_semibold"
                android:textColor="@color/petlar_texto"
                android:textSize="19sp"
                tools:text="R$ 587,10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatus"
                style="@style/Widget.PetLar.Button.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-12dp"
                android:fontFamily="@font/zilla_slab_regular"
                android:text="@string/admin_alterar_status"
                android:textSize="16sp"
                app:fontFamily="@font/zilla_slab_regular" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

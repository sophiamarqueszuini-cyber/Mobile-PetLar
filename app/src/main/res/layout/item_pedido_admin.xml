<?xml version="1.0" encoding="utf-8"?>
<!-- Pedido na lista do painel administrativo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PetLar.Card.Arredondado"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:contentPaddingBottom="8dp"
    app:contentPaddingLeft="18dp"
    app:contentPaddingRight="18dp"
    app:contentPaddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.PetLar.CartaoTitulo"
                tools:text="Pedido #882421" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_status"
                android:fontFamily="@font/zilla_slab_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/petlar_marrom_texto"
                android:textSize="13sp"
                tools:text="Pagamento confirmado" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/petlar_texto"
            android:textSize="15sp"
            tools:text="Maria Silva · maria@petlar.com" />

        <TextView
            android:id="@+id/txtDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.PetLar.Corpo"
            android:textSize="14sp"
            tools:text="28/09/2026 12:05 · 3 itens · ⚡ PIX" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/zilla_slab_bold"
                android:textColor="@color/petlar_texto"
                android:textSize="18sp"
                tools:text="R$ 587,10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatus"
                style="@style/Widget.PetLar.Button.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_alterar_status" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
